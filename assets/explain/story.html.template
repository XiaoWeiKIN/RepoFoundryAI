<!doctype html>
<html lang="@@LANG@@">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="referrer" content="no-referrer"><meta http-equiv="Content-Security-Policy" content="@@CSP@@">
<title>@@UI_page_title@@</title>
<style>
:root{--bg:#0e161d;--panel:#17242d;--ink:#edf3ed;--muted:#b8c8ca;--line:#3a4c53;--accent:#b6f289;--amber:#fed194}
*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.65 @@FONT@@}header{flex-wrap:wrap;padding:22px 5vw;border-bottom:1px solid var(--line);display:flex;justify-content:space-between;gap:20px;font-size:12px;letter-spacing:.09em}main{max-width:1280px;margin:auto;padding:40px 28px}h1{font-size:clamp(26px,4vw,48px);line-height:1.16;letter-spacing:-.035em;margin:12px 0 18px}h2{font-size:21px;margin:0 0 14px}.eyebrow{font-size:12px;color:var(--accent);letter-spacing:.14em}.intro{max-width:750px;color:var(--muted)}.grid{display:grid;grid-template-columns:260px minmax(0,1fr);gap:24px;margin-top:30px}.panel{min-width:0;border:1px solid var(--line);border-radius:12px;padding:24px;background:var(--panel)}nav button{width:100%;text-align:left;margin-bottom:8px;border-color:transparent;color:var(--muted)}button{flex-shrink:0;cursor:pointer;background:transparent;color:var(--ink);border:1px solid var(--line);border-radius:7px;padding:9px 13px;font:inherit;font-size:13px}button[aria-current="step"]{color:var(--accent);background:#233a2f;border-color:#4c6c54}button:focus-visible,input:focus-visible,summary:focus-visible{outline:2px solid var(--accent);outline-offset:4px}.controls{display:flex;align-items:center;gap:14px;margin:24px 0 12px}input[type=range]{min-width:0;width:100%;accent-color:var(--accent)}.statement{font-size:clamp(20px,2.5vw,29px);line-height:1.45;margin:24px 0}.kind{font:11px ui-monospace,monospace;color:var(--amber);text-transform:uppercase}.small{font-size:12px;color:var(--muted)}.boundary{border-left:2px solid var(--amber);padding:8px 14px;margin:20px 0;color:var(--amber);font-size:13px}pre{white-space:pre-wrap;overflow-wrap:anywhere;font:12px/1.75 ui-monospace,monospace;max-height:440px;overflow:auto}details{border-top:1px solid var(--line);padding-top:16px;margin-top:20px}summary{cursor:pointer;color:var(--muted);font-size:13px}.fact{padding:14px 0;border-bottom:1px solid var(--line)}.fact p{margin:4px 0}.digest{overflow-wrap:anywhere;font:11px/1.7 ui-monospace,monospace}.visual{margin-top:22px;overflow:auto}.visual canvas{max-width:none;display:block}.error{color:var(--amber)}footer{color:var(--muted);font-size:12px;margin-top:24px}.meta{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-top:24px}.meta div{min-width:0}#evidence{padding:10px 0}.frame{font:12px ui-monospace,monospace;white-space:nowrap}
@media(max-width:800px){main{padding:24px 16px}.grid{grid-template-columns:minmax(0,1fr)}nav{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}nav button{min-width:0;margin-bottom:0}.panel{padding:18px}.meta{grid-template-columns:minmax(0,1fr)}}
@media(prefers-reduced-motion:reduce){*{scroll-behavior:auto}}
:lang(zh-CN) h1{line-height:1.35;letter-spacing:0}:lang(zh-CN) .eyebrow{letter-spacing:.04em}#relationships{overflow-wrap:anywhere;padding-left:24px}.visual svg{min-width:720px;display:block}.visual:focus-visible{outline:2px solid var(--accent);outline-offset:4px}
</style></head>
<body><header><strong>@@UI_brand@@</strong><span>@@UI_badge@@</span></header>
<main><div class="eyebrow">@@UI_eyebrow@@</div><h1 id="title"></h1><p class="intro">@@UI_intro@@</p>
<div class="grid"><aside class="panel"><nav id="steps" aria-label="@@UI_steps@@"></nav><p class="small">@@UI_reading@@</p></aside>
<section class="panel" aria-label="@@UI_current_scene@@"><div id="kind" class="kind"></div><h2 id="scene-title"></h2><p id="statement" class="statement"></p>
<div class="controls"><button id="play">@@UI_play@@</button><input id="seek" type="range" min="0" value="0" aria-label="@@UI_frame@@"><span id="frame" class="frame"></span></div>
<p class="small">@@UI_source_note@@</p>
<div id="visual" class="visual" tabindex="0" aria-label="@@UI_graph@@"></div><p id="visual-note" class="small"></p>
<div class="boundary">@@UI_boundary@@</div>
<details><summary>@@UI_relationships@@</summary><ul id="relationships"></ul></details>
<details><summary>@@UI_evidence@@</summary><div id="evidence"></div></details></section></div>
<section class="panel" style="margin-top:24px"><h2>@@UI_full@@</h2><div id="facts"></div>
<div class="meta"><div><p class="small">@@UI_captured@@</p><pre id="provenance"></pre></div><div><p class="small">@@UI_digest@@</p><p id="digest" class="digest"></p><p class="small">@@UI_hash_note@@</p></div></div>
<details><summary>@@UI_capsule@@</summary><pre id="capsule"></pre></details>
<details><summary>@@UI_snapshot@@</summary><pre id="snapshot"></pre></details></section>
<footer>@@UI_footer@@</footer></main>
<script type="application/json" id="ir">@@IR@@</script>
<script type="application/json" id="presentation">@@PRESENTATION@@</script>
@@VENDOR@@
<script type="module">
@@FRAME_MODEL@@
const ir=JSON.parse(document.getElementById('ir').textContent);
const reading=JSON.parse(document.getElementById('presentation').textContent);
const ui=reading.labels;
atPresentedFrame(ir,reading,0); // Reject a mismatched companion before rendering.
const $=id=>document.getElementById(id);
let frame=0, playing=false, epoch=0, startFrame=0, raf=null;
const el=(tag,text)=>{const n=document.createElement(tag);n.textContent=text;return n;};
const resolve=path=>path.slice(1).split('/').reduce((v,k)=>v[k.replaceAll('~1','/').replaceAll('~0','~')],ir.source.snapshot);
$('title').textContent=reading.title;
$('seek').max=ir.timeline.duration_frames-1;
$('digest').textContent=ir.sha256;
$('provenance').textContent=JSON.stringify(ir.source.snapshot.provenance,null,2);
$('snapshot').textContent=JSON.stringify(ir.source.snapshot,null,2);
$('capsule').textContent=ir.source.snapshot.capsule?.text ?? reading.statements.capsule;
for(const s of ir.statements){const card=el('div','');card.className='fact';const tag=el('span',ui[s.kind]);tag.className='kind';card.append(tag,el('p',reading.statements[s.id]),el('code',s.refs.join(' · ')));$('facts').append(card);}
for(const [i,s] of ir.scenes.entries()){const b=el('button',reading.scenes[s.id]);b.addEventListener('click',()=>{stop();setFrame(s.from_frame);});b.dataset.index=i;$('steps').append(b);}
for(const e of ir.graph.edges)$('relationships').append(el('li',`${e.from} ${ui.requires} ${e.to}`));
if(!ir.graph.edges.length)$('relationships').append(el('li',ui.empty_graph));
let drawVisual=()=>{};
@@VISUAL@@
function setFrame(value){const state=atPresentedFrame(ir,reading,value);frame=state.frame;$('seek').value=frame;$('frame').textContent=`${frame} / ${ir.timeline.duration_frames-1}`;$('kind').textContent=state.statements.map(s=>ui[s.kind]).join(' · ');$('scene-title').textContent=state.scene.title;$('statement').textContent=state.statements.map(s=>s.text).join(' ');$('evidence').replaceChildren();for(const s of state.statements)for(const ref of s.refs){const d=el('details','');d.append(el('summary',ref),el('pre',JSON.stringify(resolve(ref),null,2)));$('evidence').append(d);}for(const b of $('steps').children)b.setAttribute('aria-current',Number(b.dataset.index)===state.index?'step':'false');drawVisual(state);}
function stop(){playing=false;if(raf!==null)cancelAnimationFrame(raf);raf=null;$('play').textContent=ui.play;}
function tick(now){raf=null;if(!playing)return;const next=startFrame+Math.floor((now-epoch)*ir.timeline.fps/1000);setFrame(next);if(next>=ir.timeline.duration_frames-1){stop();return;}raf=requestAnimationFrame(tick);}
$('play').addEventListener('click',()=>{if(playing){stop();return;}if(frame===ir.timeline.duration_frames-1)setFrame(0);playing=true;startFrame=frame;epoch=performance.now();$('play').textContent=ui.pause;raf=requestAnimationFrame(tick);});
$('seek').addEventListener('input',()=>{stop();setFrame(Number($('seek').value));});
document.addEventListener('visibilitychange',()=>{if(document.hidden)stop();});
setFrame(0);
</script></body></html>
